# Get your API key from SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# The verified sender email in SendGrid (must be verified in SendGrid settings)
SENDER_EMAIL=your-verified-sender@example.com

# Your email address where casting/crew submissions will be sent
RECIPIENT_EMAIL=your-email@example.com

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Your website base URL (for Stripe redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
